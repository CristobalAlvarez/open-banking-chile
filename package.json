{
  "name": "open-banking-chile",
  "version": "3.0.0",
  "description": "Scrapers open source para bancos chilenos. Obtén tus movimientos y saldo como JSON. Open source scrapers for Chilean banks.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:arch": "ast-grep test --skip-snapshot-tests && ast-grep scan",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "dupes": "jscpd src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:arch && npm run typecheck && npm run knip && npm run depcruise && npm run dupes && npm run format:check && npm test",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run check && npm run check:package",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "open-banking",
    "chile",
    "bank-scraper",
    "finanzas",
    "banking",
    "scraper",
    "puppeteer",
    "banco-falabella",
    "banco-chile",
    "santander",
    "bci",
    "banco-estado",
    "movimientos",
    "cartola"
  ],
  "author": "Kai Horwitz <kai@makana.cl>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaihv/open-banking-chile.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.59.1",
    "puppeteer-core": "^24.0.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.1",
    "@types/node": "^20",
    "dependency-cruiser": "^18.7.2",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
